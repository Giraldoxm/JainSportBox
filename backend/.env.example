# Conexion a la base de datos.
# Local (por defecto si se omite): SQLite -> sqlite:///crossfit.db
# Produccion: URI de Postgres (Supabase). Acepta "postgres://" o "postgresql://";
# database.py lo normaliza a "postgresql+psycopg://" y le agrega sslmode=require.
#
# IMPORTANTE: usar el *session pooler* de Supabase (puerto 5432), NO el
# transaction pooler (6543). El scheduler toma un advisory lock a nivel de sesion
# que el modo transaction liberaria solo.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Tamano del pool de SQLAlchemy (solo aplica a Postgres). Los defaults estan
# dimensionados para el plan free de Supabase con 1 worker de uvicorn.
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2

# Clave secreta para firmar tokens JWT. Genera una aleatoria y única por entorno,
# p.ej.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<genera-un-secret-aleatorio-largo>

# Credenciales del usuario administrador por defecto
ADMIN_NOMBRE=Jain Admin
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=<define-una-contraseña-fuerte>
ADMIN_TELEFONO=+57 300 000 0000
ADMIN_DOCUMENTO=<documento-admin>

# Clave secreta compartida con el bridge .NET para autenticarse sin JWT.
# DEBE coincidir con la BRIDGE_SECRET del bridge. Genera una aleatoria:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_SECRET=<genera-un-secret-aleatorio>

# Orígenes CORS permitidos (coma-separado). Local usa los puertos de Vite por
# defecto si se omite. En producción: dominios del frontend.
# CORS_ORIGINS=https://app.tudominio.com,http://localhost:4173

# Almacenamiento de fotos en object storage S3-compatible.
# Si S3_BUCKET se define, las fotos van al bucket; si no, al filesystem local.
# Necesario en la nube (Render tiene filesystem efímero).
#
# Produccion: Supabase Storage (protocolo S3). El bucket debe ser PUBLICO o las
# fotos no cargan en el navegador. Las credenciales salen de Storage -> S3 access
# keys, y S3_REGION debe ser la region real del proyecto (no "auto").
# S3_BUCKET=jainsportbox
# S3_PUBLIC_URL=https://<ref>.supabase.co/storage/v1/object/public/jainsportbox
# S3_ENDPOINT_URL=https://<ref>.storage.supabase.co/storage/v1/s3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-2
#
# Alternativa Cloudflare R2 (ahi si S3_REGION=auto):
# S3_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com